{
  "name": "vue-waterfall-mini",
  "version": "1.1.6",
  "author": {
    "name": "Dave_12138",
    "email": "dave-12138@outlook.com",
    "url": "https://dave-12138.cn"
  },
  "keywords": ["vue", "waterfall"],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dave-12138/vue-waterfall-mini"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm type-check && pnpm build-only",
    "preview": "vite preview",
    "build-only": "vite build --mode lib && terser dist/*.esm.js -c -m --module -o dist/vue-waterfall-mini.esm.min.js",
    "build-only:example": "vite build",
    "type-check": "vue-tsc --build --force",
    "sent-to-webroot": "pnpm build && to-webroot.bat"
  },
  "exports": {
    ".": {
      "import": {
        "default": "./dist/vue-waterfall-mini.esm.js",
        "types": "./dist/types/main.d.ts"
      },
      "require": {
        "default": "./dist/vue-waterfall-mini.cjs.js",
        "types": "./dist/types/main.d.ts"
      }
    },
    "./style": "./dist/style.css",
    "./style.css": "./dist/style.css"
  },
  "main": "dist/vue-waterfall-mini.cjs.js",
  "module": "dist/vue-waterfall-mini.esm.js",
  "types": "dist/types/main.d.ts",
  "devDependencies": {
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.16.10",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/tsconfig": "^0.5.1",
    "@vueuse/core": "^11.1.0",
    "less": "^4.2.0",
    "terser": "^5.34.1",
    "typescript": "~5.4.5",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "vue": "^3.5.10",
    "vue-tsc": "^2.1.6"
  },
  "peerDependencies": {
    "vue": "^3.5.10"
  }
}
